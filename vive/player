def to_display_image(img):
    """
    Convert image to displayable BGR format.
    RGB: 그대로 사용
    Depth(uint16): 8bit 변환 후 colormap 적용
    """

    # depth image
    if img.ndim == 2:

        # uint16 depth
        if img.dtype == np.uint16:

            # 0 값 제외하고 최대값 계산 (depth sensor에서 0은 invalid인 경우 많음)
            valid = img[img > 0]

            if valid.size == 0:
                img8 = np.zeros_like(img, dtype=np.uint8)
            else:
                max_depth = valid.max()

                # depth → 8bit
                scale = 255.0 / max_depth
                img8 = cv2.convertScaleAbs(img, alpha=scale)

        else:
            img8 = cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

        # depth visualization
        img_color = cv2.applyColorMap(img8, cv2.COLORMAP_JET)

        return img_color

    # RGB image
    return img


def resize_keep_aspect(img, tile_w, tile_h):
    h, w = img.shape[:2]
    scale = min(tile_w / w, tile_h / h)
    new_w = max(1, int(round(w * scale)))
    new_h = max(1, int(round(h * scale)))

    interpolation = cv2.INTER_LINEAR if scale > 1.0 else cv2.INTER_AREA
    resized = cv2.resize(img, (new_w, new_h), interpolation=interpolation)
    canvas = np.zeros((tile_h, tile_w, 3), dtype=np.uint8)

    y0 = (tile_h - new_h) // 2
    x0 = (tile_w - new_w) // 2
    canvas[y0:y0 + new_h, x0:x0 + new_w] = resized
    return canvas


def draw_label(img, text):
    out = img.copy()
    cv2.rectangle(out, (0, 0), (out.shape[1], 28), (0, 0, 0), -1)
    cv2.putText(out, text, (8, 20),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 1, cv2.LINE_AA)
    return out


def make_tiled_canvas(images, tile_cols=None, tile_size=DISPLAY_TILE_SIZE, header_text=None):
    cam_names = sorted(images.keys())
    n = len(cam_names)

    tile_w, tile_h = tile_size

    if n == 0:
        return np.zeros((tile_h, tile_w, 3), dtype=np.uint8)

    if tile_cols is None:
        tile_cols = int(math.ceil(math.sqrt(n)))
    tile_rows = int(math.ceil(n / tile_cols))

    tiles = []
    for cam_name in cam_names:
        img = to_display_image(images[cam_name])
        img = resize_keep_aspect(img, tile_w, tile_h)
        img = draw_label(img, cam_name)
        tiles.append(img)

    blank = np.zeros((tile_h, tile_w, 3), dtype=np.uint8)
    while len(tiles) < tile_rows * tile_cols:
        tiles.append(blank.copy())

    rows = []
    for r in range(tile_rows):
        row = tiles[r * tile_cols:(r + 1) * tile_cols]
        rows.append(np.hstack(row))

    canvas = np.vstack(rows)

    if header_text is not None:
        header_h = 30
        out = np.zeros((canvas.shape[0] + header_h, canvas.shape[1], 3), dtype=np.uint8)
        out[header_h:, :, :] = canvas
        cv2.putText(out, header_text, (8, 20),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1, cv2.LINE_AA)
        return out

    return canvas


def setup_window(window_name, canvas_width, canvas_height):
    cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
    win_w = min(canvas_width, MAX_WINDOW_SIZE[0])
    win_h = min(canvas_height, MAX_WINDOW_SIZE[1])
    cv2.resizeWindow(window_name, win_w, win_h)


def playback(h5_path: str, start_step: int = 0, delay_ms: int = 30, tile_cols=None):
    with h5py.File(h5_path, "r") as f:
        num_steps = int(f.attrs["num_steps"])
        obs = f["observations"]
        img_group = obs["images"]
        proprio_ds = obs["proprio"]            # v2
        action_ds = f["actions"]               # v2
        timestamp_ds = f["timestamps"]

        image_height = f.attrs['image_height']
        image_width = f.attrs['image_width']

        cam_names = sorted(list(img_group.keys()))

        print(f"playback start: total {num_steps} steps")
        print(f"display tile size: {DISPLAY_TILE_SIZE}")

        window_name = "HDF5 Playback"
        window_initialized = False

        for step in range(start_step, num_steps):
            print("=" * 60)
            print(f"step: {step}")
            print(f"timestamp: {timestamp_ds[step]}")
            print(f"proprio shape: {proprio_ds[step].shape}")
            print(f"action shape: {action_ds[step].shape}")

            images = {}
            for cam_name in cam_names:
                try:
                    img = decode_image(img_group, cam_name, step, image_height, image_width)
                    images[cam_name] = img
                except ValueError as e:
                    print(e)

            tiled = make_tiled_canvas(
                images,
                tile_cols=tile_cols,
                tile_size=DISPLAY_TILE_SIZE,
                header_text=f"step={step}  timestamp={timestamp_ds[step]}"
            )

            if not window_initialized:
                setup_window(window_name, tiled.shape[1], tiled.shape[0])
                window_initialized = True

            cv2.imshow(window_name, tiled)

            key = cv2.waitKey(delay_ms) & 0xFF
            if key == 27 or key == ord('q'):
                break

    cv2.destroyAllWindows()


def main():
    if len(sys.argv) < 2:
        print("usage:")
        print(f"  {sys.argv[0]} episode0.h5")
        print(f"  {sys.argv[0]} episode0.h5 inspect")
        print(f"  {sys.argv[0]} episode0.h5 step 10")
        print(f"  {sys.argv[0]} episode0.h5 play")
        print(f"  {sys.argv[0]} episode0.h5 play 0 30 3")
        return

    h5_path = sys.argv[1]

    if len(sys.argv) == 2:
        inspect_file(h5_path)
        return

    mode = sys.argv[2]

    if mode == "inspect":
        inspect_file(h5_path)

    elif mode == "step":
        if len(sys.argv) < 4:
            print("please provide step index")
            return

        step = int(sys.argv[3])
        data = load_step(h5_path, step)

        print("num_steps:", data["num_steps"])
        print("timestamp:", data["timestamp"])
        print("proprio shape:", data["proprio"].shape)
        print("action shape:", data["action"].shape)
        print("proprio[:10]:", data["proprio"][:10])
        print("action[:10]:", data["action"][:10])

        tiled = make_tiled_canvas(
            data["images"],
            tile_cols=None,
            tile_size=DISPLAY_TILE_SIZE,
            header_text=f"step={step}  timestamp={data['timestamp']}"
        )

        window_name = "HDF5 Step Viewer"
        setup_window(window_name, tiled.shape[1], tiled.shape[0])
        cv2.imshow(window_name, tiled)
        cv2.waitKey(0)
        cv2.destroyAllWindows()

    elif mode == "play":
        start_step = int(sys.argv[3]) if len(sys.argv) >= 4 else 0
        delay_ms = int(sys.argv[4]) if len(sys.argv) >= 5 else 30
        tile_cols = int(sys.argv[5]) if len(sys.argv) >= 6 else None
        playback(h5_path, start_step=start_step, delay_ms=delay_ms, tile_cols=tile_cols)

    else:
        print(f"unknown mode: {mode}")


if __name__ == "__main__":
    main()
