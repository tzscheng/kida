def load_step(h5_path: str, step: int):
    with h5py.File(h5_path, "r") as f:
        num_steps = int(f.attrs["num_steps"])

        if step < 0 or step >= num_steps:
            raise IndexError(f"step {step} out of range (0 ~ {num_steps - 1})")

        obs = f["observations"]
        img_group = obs["images"]
        proprio_ds = obs["proprio"]            # v2: was observations/proprioceptive_data
        action_ds = f["actions"]               # v2: now a dataset, was actions/target_positions
        timestamp_ds = f["timestamps"]

        image_height = f.attrs['image_height']
        image_width = f.attrs['image_width']

        cam_names = sorted(list(img_group.keys()))
        images = {}

        for cam_name in cam_names:
            images[cam_name] = decode_image(img_group, cam_name, step, image_height, image_width)

        proprio = proprio_ds[step]
        action = action_ds[step]
        timestamp = timestamp_ds[step]

        return {
            "images": images,
            "proprio": proprio,
            "action": action,
            "timestamp": timestamp,
            "num_steps": num_steps,
        }


