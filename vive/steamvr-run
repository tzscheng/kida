#!/bin/sh
#
# Start SteamVR and keep Steam/SteamVR processes away from the cores used by kida:
# Keep Steam/SteamVR on the default CPU set below. Override with STEAMVR_CPUSET.

CPUSET="${STEAMVR_CPUSET:-9-11}"

steam steam://run/250820 &

for _ in $(seq 1 80); do
    pids="$(pgrep -f '(^|/)steam($| )|steamwebhelper|steam-runtime|steam-launch-wrapper|srt-bwrap|srt-logger|pv-adverb|reaper SteamLaunch|pressure-vessel|SteamVR/bin/linux64/vrserver|SteamVR/bin/linux64/vrmonitor|vrcompositor|vrwebhelper' || true)"
    if [ -n "$pids" ]; then
        for pid in $pids; do
            taskset -cp "$CPUSET" "$pid" >/dev/null 2>&1 || true
        done
    fi
    sleep 0.25
done
